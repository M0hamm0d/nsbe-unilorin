# Server-only. Never prefix the service role key with NEXT_PUBLIC_
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin demo auth. Use a random value of at least 32 characters for the session secret.
ADMIN_SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_DEMO_PASSWORD=nsbe-demo
